# Config for /opt/openssl only (the distro libssl reads its own file).
# Loads the built-in default provider plus oqsprovider.
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default     = default_sect
oqsprovider = oqsprovider_sect

[default_sect]
activate = 1

[oqsprovider_sect]
module   = /opt/openssl/lib/ossl-modules/oqsprovider.so
activate = 1

# Minimal req section so `openssl req -subj ...` works without extra config.
[req]
distinguished_name = req_dn
prompt             = no

[req_dn]
