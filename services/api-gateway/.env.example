# Local development only. Copy to .env (git-ignored) and start the app with:
#   uvicorn api_gateway.main:create_app --factory --reload --env-file .env
# Never put a real password in this file or commit a filled-in .env.

# --- Gateway (see api_gateway/config.py) ---
PQCA_GATEWAY_ENVIRONMENT=dev
# Dev defaults to http://localhost:3000 and http://localhost:5173. Override with a comma-separated list:
# PQCA_GATEWAY_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Database (read by pqca_common.db; see packages/pqca-common/README.md) ---
PQCA_DB_HOST=localhost
PQCA_DB_PORT=5432
PQCA_DB_NAME=pqca
PQCA_DB_USER=gateway_svc
PQCA_DB_PASSWORD=
