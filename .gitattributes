# Normalize line endings. Shell scripts and SQL must stay LF or they break
# inside Linux containers when checked out on Windows.
* text=auto eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.png  binary
*.jpg  binary
*.pdf  binary
*.docx binary
